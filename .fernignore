README.md

# Custom exports - add any additional type exports here.
# This file is imported by index.ts via: export * from "./exports.js"
src/exports.ts

# ApolloClient wrapper: extends the generated client to add authentication. Accepts
# publishableKey (pk_network_ / pk_org_) or organizationApiKey. Publishable keys are
# exchanged at POST /management/v1/auth/token for a short-lived bearer that is
# auto-refreshed and sent as Authorization on every request (and on the WS upgrade
# via client.connect()). Re-exported as ApolloClient in index.ts so consumers see no
# naming change.
src/ApolloClientWrapper.ts

# index.ts re-exports ApolloClientWrapper as ApolloClient instead of the raw generated
# Client. Protected so the wrapper swap survives every Fern regen. NOTE: index.ts is now
# frozen, so new top-level named exports must be added here manually. New API models still
# flow through automatically via `export * as Apollo from "./api/index.js"`.
src/index.ts
